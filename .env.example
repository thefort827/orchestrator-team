# Orchestrator Team — Environment Variables
# Copy to .env and fill in your credentials

# ============================================
# LLM Provider (choose one)
# ============================================

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Google
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1

# Azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Local (vLLM / Ollama / LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=

# ============================================
# Infrastructure
# ============================================
DATABASE_URL=postgresql://orchestrator:orchestrator_dev@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379

# Optional
NATS_URL=nats://localhost:4222
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# ============================================
# Runtime
# ============================================
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_MAX_PARALLELISM=4
ORCHESTRATOR_DEFAULT_BUDGET=300000
