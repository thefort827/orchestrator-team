# Orchestrator Team — Environment Variables
# Copy to .env and fill in your credentials

# ============================================
# LLM Providers (fill in at least one)
# ============================================

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local / Self-hosted (vLLM, Ollama, LM Studio, etc.)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://orchestrator:orchestrator_dev@localhost:5432/orchestrator

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Message Queue (optional)
# ============================================
NATS_URL=nats://localhost:4222

# ============================================
# Secrets Management (optional)
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# ============================================
# Orchestrator Config
# ============================================
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_MAX_PARALLELISM=4
ORCHESTRATOR_DEFAULT_BUDGET=300000
